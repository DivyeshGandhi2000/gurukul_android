<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color (10% opacity of Dark Red) -->
    <solid android:color="#1A8B0000" />

    <!-- Border stroke (Solid Dark Red) -->
    <stroke
        android:width="2dp"
        android:color="#8B0000" />

    <!-- Rounded corners -->
    <corners android:radius="12dp" />

    <!-- Padding inside the shape -->
    <padding
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp" />
</shape>