<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true">

    <View
        android:id="@+id/fakeStatusBar"
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:background="@color/primary"
        android:visibility="gone"
        android:paddingVertical="15dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/fakeStatusBar"
        android:layout_marginTop="0dp"
        android:background="#F5F5F5"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/rootLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:text="Select Video Format"
                android:textColor="@color/primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/videoColorGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 1. BLUE CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVideoBlue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivBlueColor"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardBackgroundColor="#1976D2"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:layout_marginStart="2dp"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#FFFFFF" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvBlueName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Animation 1"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/ivViewBlue"
                            app:layout_constraintStart_toEndOf="@id/ivBlueColor"
                            app:layout_constraintTop_toTopOf="@id/ivBlueColor" />

                        <TextView
                            android:id="@+id/tvBlueDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Classic slide animation"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/tvBlueName"
                            app:layout_constraintStart_toStartOf="@id/tvBlueName"
                            app:layout_constraintTop_toBottomOf="@id/tvBlueName" />

                        <ImageView
                            android:id="@+id/ivViewBlue"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/outline_eye_tracking_24"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/radioVideoBlue"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#9E9E9E" />

                        <RadioButton
                            android:id="@+id/radioVideoBlue"
                            style="@style/CustomRadioButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 2. BROWN CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVideoBrown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivBrownColor"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardBackgroundColor="#795548"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:layout_marginStart="2dp"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#FFFFFF" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvBrownName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Animation 2"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/ivViewBrown"
                            app:layout_constraintStart_toEndOf="@id/ivBrownColor"
                            app:layout_constraintTop_toTopOf="@id/ivBrownColor" />

                        <TextView
                            android:id="@+id/tvBrownDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Premium zoom and pan"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/tvBrownName"
                            app:layout_constraintStart_toStartOf="@id/tvBrownName"
                            app:layout_constraintTop_toBottomOf="@id/tvBrownName" />

                        <ImageView
                            android:id="@+id/ivViewBrown"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/outline_eye_tracking_24"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/radioVideoBrown"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#9E9E9E" />

                        <RadioButton
                            android:id="@+id/radioVideoBrown"
                            style="@style/CustomRadioButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. RED CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVideoRed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivRedColor"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardBackgroundColor="#F44336"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:layout_marginStart="2dp"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#FFFFFF" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvRedName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Animation 3"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/ivViewRed"
                            app:layout_constraintStart_toEndOf="@id/ivRedColor"
                            app:layout_constraintTop_toTopOf="@id/ivRedColor" />

                        <TextView
                            android:id="@+id/tvRedDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Dynamic pop up transitions"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/tvRedName"
                            app:layout_constraintStart_toStartOf="@id/tvRedName"
                            app:layout_constraintTop_toBottomOf="@id/tvRedName" />

                        <ImageView
                            android:id="@+id/ivViewRed"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/outline_eye_tracking_24"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/radioVideoRed"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#9E9E9E" />

                        <RadioButton
                            android:id="@+id/radioVideoRed"
                            style="@style/CustomRadioButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. GREEN CARD -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVideoGreen"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="6dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp">

                        <com.google.android.material.card.MaterialCardView
                            android:id="@+id/ivGreenColor"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            app:cardBackgroundColor="#4CAF50"
                            app:cardCornerRadius="28dp"
                            app:cardElevation="0dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:strokeWidth="0dp">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_gravity="center"
                                android:layout_marginStart="2dp"
                                android:src="@android:drawable/ic_media_play"
                                app:tint="#FFFFFF" />

                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:id="@+id/tvGreenName"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="8dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Animation 4"
                            android:textColor="@color/primary"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toStartOf="@+id/ivViewGreen"
                            app:layout_constraintStart_toEndOf="@id/ivGreenColor"
                            app:layout_constraintTop_toTopOf="@id/ivGreenColor" />

                        <TextView
                            android:id="@+id/tvGreenDescription"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Modern staggered animations"
                            android:textColor="#757575"
                            android:textSize="14sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="@id/tvGreenName"
                            app:layout_constraintStart_toStartOf="@id/tvGreenName"
                            app:layout_constraintTop_toBottomOf="@id/tvGreenName" />

                        <ImageView
                            android:id="@+id/ivViewGreen"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="8dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="6dp"
                            android:src="@drawable/outline_eye_tracking_24"
                            android:visibility="gone"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/radioVideoGreen"
                            app:layout_constraintTop_toTopOf="parent"
                            app:tint="#9E9E9E" />

                        <RadioButton
                            android:id="@+id/radioVideoGreen"
                            style="@style/CustomRadioButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                    </androidx.constraintlayout.widget.ConstraintLayout>
                </com.google.android.material.card.MaterialCardView>

            </RadioGroup>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>