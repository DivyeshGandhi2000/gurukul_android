<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/rootLayout"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/shanti_dhara"
            android:textColor="#8B0000"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/ivPreview"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp"
            android:contentDescription="@string/image_preview" />

        <Button
            android:id="@+id/btnSelectImage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_image"
            android:backgroundTint="#9b1c1e"
            />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/textInputLayout"
            style="@style/StyledTextInputLayout"
            android:layout_marginTop="25dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/name"
            app:passwordToggleTint="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etName"

                style="@style/StyledEditText"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>


        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layout_discriptionEtn"
            style="@style/StyledTextInputLayout"
            android:layout_width="match_parent"
            android:layout_weight="0"
            android:layout_marginTop="20dp"
            android:overScrollMode="always"
            android:scrollbarStyle="insideOverlay"
            android:layout_height="wrap_content"
            android:hint="@string/description"

            >

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:minLines="3"
                android:maxLines="10"
                android:inputType="textMultiLine"
                />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout

            style="@style/StyledTextInputLayout"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:hint="@string/select_date"
            app:passwordToggleTint="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDate"
                style="@style/StyledEditText"
                android:inputType="text"
                android:paddingEnd="16dp"
                android:clickable="true"
                android:focusable="false"
                android:cursorVisible="false"
                android:paddingVertical="16dp"
                android:drawableEnd="@drawable/ic_dashboard" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/StyledDropdownTextInputLayout"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/select">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                style="@style/StyledDropdownEditText"
                android:id="@+id/spinnerType"
                android:inputType="text"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:cursorVisible="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <RadioGroup
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginVertical="10dp"
            android:orientation="horizontal"
            android:visibility="gone"
            android:id="@+id/HideVisibileGroup"
            android:gravity="center_vertical">

            <RadioButton
                android:id="@+id/Hide"
                android:layout_width="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_height="wrap_content"
                android:text="@string/hide"
                android:textSize="16sp"
                style="@style/CustomRadioButton"
                android:checked="true" />

            <RadioButton
                android:id="@+id/Visible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/visible"
                android:textSize="16sp"
                style="@style/CustomRadioButton" />
        </RadioGroup>

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            android:gravity="center"
            android:background="@drawable/gradient_btn"
            android:text="@string/save_status"
            android:textColor="@color/white"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </LinearLayout>
</ScrollView>

