<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_margin="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Print Template"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/templateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioClassic"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Classic (Red &amp; Cream)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioModern"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Modern (Deep Blue &amp; White)" />

            <RadioButton
                android:id="@+id/radioGold"
                style="@style/CustomRadioButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Premium (Dark Grey &amp; Gold)" />

            <!-- ✅ FIXED: radioBlue is now INSIDE templateGroup -->
            <RadioButton
                android:id="@+id/radioBlue"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Modern Cyan (Blue &amp; White)" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Font Style"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/fontGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/fontDefault"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Default (System Font)"
                android:checked="true" />

            <RadioButton
                android:id="@+id/fontSerif"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Serif (Traditional)" />

            <RadioButton
                android:id="@+id/fontMonospace"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Monospace (Modern)" />

            <RadioButton
                android:id="@+id/fontSansSerif"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Sans Serif (Clean)" />

        </RadioGroup>

        <!-- New Video Color Selection Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select Video Color"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"/>

        <RadioGroup
            android:id="@+id/videoColorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/radioVideoBlue"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Blue"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioVideoBrown"
                android:layout_width="match_parent"
                style="@style/CustomRadioButton"
                android:layout_height="wrap_content"
                android:text="Brown" />

        </RadioGroup>

    </LinearLayout>
</ScrollView>